[node name="MovesText" type="RichTextLabel" parent="MoveListModal/Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "[color=#00e5ff]BASIC ATTACKS[/color]
- [b]Jab[/b]: Punch [J] (Fast high-low frame startup)
- [b]Cross[/b]: [J] -> [J] (Straight mid-strike follow-up)
- [b]Hook[/b]: [J] -> [J] -> [J] (Heavy high knockout blow)
- [b]Side Kick[/b]: Kick [K] (Crisp mid-range thrust)
- [b]Roundhouse[/b]: [K] -> [K] or [J] -> [K] (High crescent sweep)

[color=#00e5ff]DIRECTIONAL COMBAT[/color]
- [b]Uppercut[/b]: Crouch [S] + Punch [J] (Anti-air vertical strike)
- [b]Low Sweep[/b]: Crouch [S] + Kick [K] (Trip standing opponent)
- [b]Jump Punch / Kick[/b]: Jump [W] + [J] / [K] (Airborne aerial descent)
- [b]High Guard[/b]: Hold Block [L] or Walk Back (Away from foe)
- [b]Low Guard[/b]: Crouch [S] + Hold Block [L]"

