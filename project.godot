; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited by hand.

config_version=5

[application]

config/name="Shadow Fighter: Dusk Duel"
config/description="An original 2D silhouette martial-arts fighting game"
config/version="3.0.0"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"

[autoload]

SaveData="*res://scripts/save_manager.gd"
Progression="*res://scripts/progression_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

